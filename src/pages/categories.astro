---
import BaseLayout from '../layouts/BaseLayout.astro';

type PostModule = {
  frontmatter: {
    title: string;
    description?: string;
    date: string | Date;
    categories?: string[];
  };
};

const modules = import.meta.glob('./posts/*.md', { eager: true }) as Record<string, PostModule>;
const posts = Object.entries(modules).map(([path, mod]) => ({
  ...mod.frontmatter,
  url: path.replace('./posts/', '/posts/').replace(/\.md$/, ''),
}));

const grouped = new Map<string, typeof posts>();
for (const post of posts) {
  if ((post.categories ?? []).includes('inbox')) continue;

  for (const category of post.categories ?? ['uncategorized']) {
    const list = grouped.get(category) ?? [];
    list.push(post);
    grouped.set(category, list);
  }
}

const categories = [...grouped.entries()].sort(([a], [b]) => a.localeCompare(b));
---

<BaseLayout title="categories" description="Posts grouped by category.">
  <h1>Categories</h1>
  {
    categories.map(([category, items]) => (
      <section>
        <h2>#{category}</h2>
        <ul>
          {items
            .sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf())
            .map((post) => <li><a href={post.url}>{post.title}</a></li>)}
        </ul>
      </section>
    ))
  }
</BaseLayout>
