---
import BaseLayout from '../layouts/BaseLayout.astro';

type PostModule = {
  frontmatter: {
    title: string;
    description?: string;
    date: string | Date;
    categories?: string[];
    type?: string;
    source?: string;
    note?: string;
  };
};

const modules = import.meta.glob('./posts/*.md', { eager: true }) as Record<string, PostModule>;
const items = Object.entries(modules)
  .map(([path, mod]) => ({
    ...mod.frontmatter,
    url: path.replace('./posts/', '/posts/').replace(/\.md$/, ''),
  }))
  .filter((post) => (post.categories ?? []).includes('inbox'))
  .sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf());

const groups = new Map<string, typeof items>();
for (const item of items) {
  const date = new Date(item.date).toISOString().slice(0, 10);
  const group = groups.get(date) ?? [];
  group.push(item);
  groups.set(date, group);
}

const formatDate = (date: string) =>
  new Intl.DateTimeFormat('en', { month: 'short', day: '2-digit' }).format(new Date(`${date}T00:00:00`));

const sourceLabel = (source?: string) => {
  if (!source) return null;
  try {
    return new URL(source).hostname.replace(/^www\./, '');
  } catch {
    return source;
  }
};
---

<BaseLayout title="inbox" description="Small things worth keeping.">
  <header class="inbox-header">
    <h1>inbox</h1>
    <p>small things worth keeping</p>
  </header>

  <div class="inbox-timeline">
    {
      [...groups.entries()].map(([date, entries]) => (
        <section class="inbox-day">
          <h2>{formatDate(date)}</h2>
          <ul class="inbox-stream">
            {entries.map((item) => (
              <li class="inbox-item">
                <div class="inbox-line">
                  <a class="inbox-title" href={item.url}>{item.title}</a>
                  <span class="inbox-meta">
                    {item.type ? <span>{item.type}</span> : null}
                    {item.source ? (
                      <a href={item.source} target="_blank" rel="noreferrer">{sourceLabel(item.source)}</a>
                    ) : null}
                  </span>
                </div>
                <p>{item.note ?? item.description}</p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
