---
import BaseLayout from '../layouts/BaseLayout.astro';

type PostModule = {
  frontmatter: {
    title: string;
    description?: string;
    date: string | Date;
    categories?: string[];
  };
};

const modules = import.meta.glob('./posts/*.md', { eager: true }) as Record<string, PostModule>;
const items = Object.entries(modules)
  .map(([path, mod]) => ({
    ...mod.frontmatter,
    url: path.replace('./posts/', '/posts/').replace(/\.md$/, ''),
  }))
  .filter((post) => (post.categories ?? []).includes('inbox'))
  .sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf());
---

<BaseLayout title="inbox" description="Loose notes, links, tools, and ideas worth keeping.">
  <h1>Inbox</h1>
  <p class="summary">Loose notes, links, tools, and ideas worth keeping before they become something more finished.</p>

  <ul class="post-list">
    {
      items.map((post) => (
        <li>
          <div class="meta">{new Date(post.date).toISOString().slice(0, 10)}</div>
          <a class="post-title" href={post.url}>{post.title}</a>
          {post.description ? <p class="summary">{post.description}</p> : null}
        </li>
      ))
    }
  </ul>
</BaseLayout>
