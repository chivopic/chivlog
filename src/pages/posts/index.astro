---
import BaseLayout from '../../layouts/BaseLayout.astro';

type PostModule = {
  frontmatter: {
    title: string;
    description?: string;
    date: string | Date;
    categories?: string[];
  };
};

const modules = import.meta.glob('./*.md', { eager: true }) as Record<string, PostModule>;
const posts = Object.entries(modules)
  .map(([path, mod]) => ({
    ...mod.frontmatter,
    url: path.replace('./', '/posts/').replace(/\.md$/, ''),
  }))
  .filter((post) => !(post.categories ?? []).includes('inbox'))
  .sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf());
---

<BaseLayout title="posts" description="All posts on chiv's blog.">
  <h1>Posts</h1>
  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <div class="meta">{new Date(post.date).toISOString().slice(0, 10)}</div>
          <a class="post-title" href={post.url}>{post.title}</a>
          {post.description ? <p class="summary">{post.description}</p> : null}
        </li>
      ))
    }
  </ul>
</BaseLayout>
